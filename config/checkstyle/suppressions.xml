<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
    "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
    "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<!--
  Code whose Chris Street Style migration slice has not merged yet (Builder umbrella plan
  2026-10-05-20-05, ledger rows 19 to 21). Each slice deletes its line when it merges; nothing
  else belongs here.
-->
<suppressions>
  <!-- Slice 19e: shared-folder media. -->
  <suppress files="[\/]sharedfolder[\/]media[\/]" checks=".*"/>
  <!-- Slice 19g: shared-folder service and the package-level shared-folder tests. -->
  <suppress files="[\/]sharedfolder[\/]service[\/]" checks=".*"/>
  <suppress files="[\/]test[\/]java[\/]dev[\/]christopherbell[\/]sharedfolder[\/][A-Za-z]+\.java$" checks=".*"/>
  <!-- Slice 19h: shared-folder file system. -->
  <suppress files="[\/]sharedfolder[\/]fs[\/]" checks=".*"/>
  <!-- Slice 20: application and cross-feature tests. -->
  <suppress files="[\/]test[\/]java[\/]dev[\/]christopherbell[\/]architecture[\/]" checks=".*"/>
  <!-- Slice 21: cbell-lib. -->
  <suppress files="[\/]cbell-lib[\/]" checks=".*"/>
</suppressions>
